{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cv.html",
      "destination": "/cv",
      "permanent": true
    },
    {
      "source": "/rapor-yonetim-kurulu.html",
      "destination": "/rapor-yonetim-kurulu",
      "permanent": true
    },
    {
      "source": "/makale-kurumsal-ceviklik.html",
      "destination": "/makale-kurumsal-ceviklik",
      "permanent": true
    },
    {
      "source": "/analiz-yetenek-savaslari.html",
      "destination": "/analiz-yetenek-savaslari",
      "permanent": true
    },
    {
      "source": "/gizlilik-politikasi.html",
      "destination": "/gizlilik-politikasi",
      "permanent": true
    },
    {
      "source": "/kullanim-sartlari.html",
      "destination": "/kullanim-sartlari",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
