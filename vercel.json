{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en.html",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/cv.html",
      "destination": "/cv",
      "permanent": true
    },
    {
      "source": "/iletisim.html",
      "destination": "/iletisim",
      "permanent": true
    },
    {
      "source": "/rapor-yonetim-kurulu.html",
      "destination": "/rapor-yonetim-kurulu",
      "permanent": true
    },
    {
      "source": "/makale-kurumsal-ceviklik.html",
      "destination": "/makale-kurumsal-ceviklik",
      "permanent": true
    },
    {
      "source": "/analiz-yetenek-savaslari.html",
      "destination": "/analiz-yetenek-savaslari",
      "permanent": true
    },
    {
      "source": "/ust-duzey-yonetici-secimi.html",
      "destination": "/ust-duzey-yonetici-secimi",
      "permanent": true
    },
    {
      "source": "/kurumsal-ik-yapilanmasi.html",
      "destination": "/kurumsal-ik-yapilanmasi",
      "permanent": true
    },
    {
      "source": "/organizasyonel-donusum.html",
      "destination": "/organizasyonel-donusum",
      "permanent": true
    },
    {
      "source": "/yetenek-ve-performans-yonetimi.html",
      "destination": "/yetenek-ve-performans-yonetimi",
      "permanent": true
    },
    {
      "source": "/yonetim-kurulu-ve-liderlik-danismanligi.html",
      "destination": "/yonetim-kurulu-ve-liderlik-danismanligi",
      "permanent": true
    },
    {
      "source": "/gizlilik-politikasi.html",
      "destination": "/gizlilik-politikasi",
      "permanent": true
    },
    {
      "source": "/kullanim-sartlari.html",
      "destination": "/kullanim-sartlari",
      "permanent": true
    },
    {
      "source": "/en/:path*.html",
      "destination": "/en/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
